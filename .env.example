# Copy to .env (which is gitignored) and fill in. Used by scripts/send_rsvp_texts.py.
# Nothing here ships to the browser - this is a local, run-once operator script.

# Supabase. Use the SERVICE ROLE key, not the anon key: the script needs to read
# every party's phone number, which RLS should be blocking for anon.
# Project Settings -> API -> service_role. Treat it like a password.
SUPABASE_URL=https://cpyxatctkiaogyhbgxdv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Twilio. Console dashboard -> Account Info.
# TWILIO_FROM must be a number registered for A2P 10DLC (or a verified
# toll-free number), otherwise carriers will filter the messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
